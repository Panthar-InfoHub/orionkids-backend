generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  RESTRICTED
}

enum QuestSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum LevelAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id                    String         @id
  name                  String
  email                 String
  emailVerified         Boolean        @default(false)
  image                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  role                  UserRole       @default(USER)
  status                UserStatus     @default(PENDING)
  restrictedReason      String?
  reviewedAt            DateTime?
  reviewedById          String?
  onboardingSubmittedAt DateTime?
  childProfiles         ChildProfile[]
  sessions              Session[]
  accounts              Account[]
  questSessions         QuestSession[]
  questReports          QuestReport[]

  @@unique([email])
  @@index([status, createdAt])
  @@index([status, onboardingSubmittedAt])
  @@map("user")
}

model ChildProfile {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  childName     String
  age           Int
  language      String
  school        String?
  selectedClass String
  studentId     String?
  parentEmail   String
  parentMobile  String
  isGuardian    Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  questSessions QuestSession[]
  questReports  QuestReport[]

  @@index([userId])
  @@map("child_profile")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
}

model QuestSession {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfileId   String?
  childProfile     ChildProfile?      @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  status           QuestSessionStatus @default(IN_PROGRESS)
  currentStage     String             @default("WARM_UP")
  currentGame      Int                @default(1)
  currentLevel     Int                @default(1)
  startedAt        DateTime           @default(now())
  lastActivityAt   DateTime           @default(now()) @updatedAt
  completedAt      DateTime?
  abandonedAt      DateTime?
  warmUpSubmission WarmUpSubmission?
  levelAttempts    LevelAttempt[]
  questReport      QuestReport?

  @@index([userId, status])
  @@index([userId, startedAt])
  @@index([childProfileId])
  @@index([childProfileId, status])
  @@index([userId, lastActivityAt])
  @@index([childProfileId, startedAt])
  @@map("quest_session")
}

model WarmUpSubmission {
  id             String       @id @default(cuid())
  questSessionId String       @unique
  questSession   QuestSession @relation(fields: [questSessionId], references: [id], onDelete: Cascade)
  userId         String
  answers        Json
  completedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@map("warm_up_submission")
}

model LevelAttempt {
  id                    String             @id @default(cuid())
  questSessionId        String
  questSession          QuestSession       @relation(fields: [questSessionId], references: [id], onDelete: Cascade)
  userId                String
  gameId                Int
  gameKey               String
  levelNumber           Int
  attemptNumber         Int                @default(1)
  status                LevelAttemptStatus @default(IN_PROGRESS)
  totalTrials           Int?
  correctTrials         Int?
  accuracy              Float?
  durationMs            Int?
  averageReactionTimeMs Int?
  metrics               Json?
  trialRecords          Json?
  startedAt             DateTime           @default(now())
  completedAt           DateTime?

  @@index([questSessionId, gameKey, levelNumber])
  @@index([userId])
  @@index([questSessionId, status])
  @@index([questSessionId, startedAt])
  @@map("level_attempt")
}

model QuestReport {
  id                 String        @id @default(cuid())
  questSessionId     String        @unique
  questSession       QuestSession  @relation(fields: [questSessionId], references: [id], onDelete: Cascade)
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  childProfileId     String?
  childProfile       ChildProfile? @relation(fields: [childProfileId], references: [id], onDelete: SetNull)
  childName          String
  age                Int
  selectedClass      String
  school             String?
  overallAccuracy    Float
  totalDurationMs    Int
  gameSummaries      Json
  cognitiveFacets    Json
  growthObservations Json
  schemaVersion      Int           @default(1)
  generatedAt        DateTime      @default(now())

  @@index([userId])
  @@index([childProfileId])
  @@map("quest_report")
}
