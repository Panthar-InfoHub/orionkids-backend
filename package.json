{
  "name": "orionkids-backend",
  "version": "1.0.0",
  "description": "Backend API for OrionKids",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "admin:make": "tsx scripts/make-admin.ts",
    "user:verify": "tsx scripts/verify-user.ts",
    "test": "NODE_ENV=test DATABASE_URL_TEST=\"${DATABASE_URL_TEST:-postgresql://postgres:postgres@localhost:5432/orionkids_test}\" node --import tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "db:inspect": "tsx scripts/inspect-db.ts",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "db:deploy-neon": "tsx scripts/deploy-neon-migration.ts",
    "db:verify-schema": "tsx scripts/verify-schema.ts",
    "db:deploy-terms": "tsx scripts/deploy-terms-migration.ts",
    "db:deploy-report": "tsx scripts/deploy-report-migration.ts",
    "test:reg": "NODE_ENV=test DATABASE_URL_TEST=\"${DATABASE_URL_TEST:-postgresql://postgres:postgres@localhost:5432/orionkids_test}\" node --import tsx --test --test-concurrency=1 tests/registration.workflow.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.13",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "openai": "^7.47.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^6.37.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
