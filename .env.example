NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Neon: POOLED connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL=

# Neon: DIRECT connection (no "-pooler"), used by the Prisma CLI for migrations
DIRECT_URL=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Cookie domain (production only, e.g. .orionkids.com)
# COOKIE_DOMAIN=

# Google OAuth (Required: Google-only authentication)
# Configure in Google Cloud Console with:
# Authorized JavaScript origin: http://localhost:8080 (and http://localhost:3000)
# Authorized redirect URI: http://localhost:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPEN_AI_API_KEY=

# ---- Report PDF storage: Cloudflare R2 (keep the bucket PRIVATE) ----
# Token permission: "Object Read & Write", limited to the bucket below
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=orionkids-reports

# ---- Parent report email: Resend (sending-access key, limited to the verified domain) ----
RESEND_API_KEY=
EMAIL_FROM="OrionKids Reports <reports@mail.orionkids.in>"
EMAIL_REPLY_TO=

# Public URL of THIS backend: used to build the report link inside emails
# (production: e.g. https://api.orionkids.in, never localhost)
REPORT_LINK_BASE_URL=http://localhost:8080
# Public URL of the frontend: expired/invalid report links redirect here
FRONTEND_BASE_URL=http://localhost:3000