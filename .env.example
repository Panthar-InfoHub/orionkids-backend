NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Neon: POOLED connection (host contains "-pooler"), used by the app at runtime
DATABASE_URL=

# Neon: DIRECT connection (no "-pooler"), used by the Prisma CLI for migrations
DIRECT_URL=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Cookie domain (production only, e.g. .orionkids.com)
# COOKIE_DOMAIN=

# Google OAuth (Required: Google-only authentication)
# Configure in Google Cloud Console with:
# Authorized JavaScript origin: http://localhost:8080 (and http://localhost:3000)
# Authorized redirect URI: http://localhost:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

